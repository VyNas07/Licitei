# ============================================================
# Pipeline Licitei — Arquitetura Medallion
# Copie para .env e preencha os valores antes de executar.
# NUNCA comite o arquivo .env no repositório.
# ============================================================

# ----- Kafka -----
# Endereço do broker. Suba com: cd kafka && docker compose up -d
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Nomes dos tópicos (opcionais — os padrões abaixo são usados se ausentes)
KAFKA_TOPIC_RAW=raw.licitacoes
KAFKA_TOPIC_TRANSFORMED=transformed.licitacoes

# ----- API PNCP -----
# Endpoint base da API pública (sem barra final)
PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1

# Código da modalidade de contratação (8 = Pregão Eletrônico)
PNCP_CODIGO_MODALIDADE=8

# Intervalo de datas para extração (formato YYYYMMDD, máx. 365 dias)
PNCP_DATA_INICIAL=20260601
PNCP_DATA_FINAL=20260602

# Registros por página — máximo aceito pela API é 50
PNCP_TAMANHO_PAGINA=50

# ----- Camadas de dados -----
# Camada Bronze: Parquet particionado por year/month/day
BRONZE_BASE_PATH=data/bronze

# Camada Silver: catálogo PyIceberg (ACID + time travel)
ICEBERG_CATALOG_PATH=data/iceberg

# Camada SQLite: upsert por numero_controle_pncp (requisito Eng. de Dados)
SQLITE_DB_PATH=data/licitacoes.db

# ----- MongoDB Atlas -----
# Mesma URI usada pelo backend e MCP
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=licitei
# Coleções Gold são gerenciadas pelo pipeline — não configurável por env var
