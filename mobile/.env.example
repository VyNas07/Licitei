# ============================================================
# Licitei — Mobile (Expo + React Native)
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA commite o arquivo .env.
# ============================================================

# URL base do backend.
# Celular físico: use o IP LAN da máquina, ex: http://192.168.1.10:3000
# Android Emulator: http://10.0.2.2:3000
# iOS Simulator ou Expo Web local: http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase público usado pelo app mobile.
# Encontre em: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon_key>
